{
  "name": "vietnam-war-1968-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Vietnam War 1968 Open-World Military Simulation FPS",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win nsis --x64 --publish never",
    "pack:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "release:win": "electron-builder --win nsis --x64 --publish always",
    "release:linux": "electron-builder --linux AppImage deb --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mekongvalley.vietnamwar1968",
    "productName": "Vietnam War 1968",
    "artifactName": "Vietnam-War-1968-${os}-${arch}-${version}.${ext}",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*",
      "icons/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/vietnam-war-1968.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/vietnam-war-1968.png",
      "category": "Game",
      "synopsis": "Open-world 1968 Mekong Valley military simulation FPS"
    }
  }
}
